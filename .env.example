# Environment Variables Template
DB_HOST=localhost
DB_PORT=3306
DB_NAME=universal_data_analyzer
DB_USER=root
DB_PASSWORD=

LLM_PROVIDER=groq
# Get a free API key at https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here
LLM_MODEL=llama-3.3-70b-versatile
LLM_MAX_TOKENS=1000
LLM_TEMPERATURE=0.3
JWT_SECRET_KEY=your-secret-key-here
SESSION_TIMEOUT_MINUTES=30
MAX_LOGIN_ATTEMPTS=5

LOG_LEVEL=INFO
MAX_FILE_SIZE_MB=50
EXPORT_DIR=./exports

# Email Notifications (SMTP) — Optional
# Leave SMTP_HOST empty to disable email notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@uda.local