# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=universal_data_analyzer
DB_USER=root
DB_PASSWORD=your_password

# Gemini LLM (free — get key at aistudio.google.com)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
LLM_MODEL=gemini-1.5-flash
LLM_MAX_TOKENS=1000
LLM_TEMPERATURE=0.3

# Security
JWT_SECRET_KEY=generate_with_secrets.token_hex(32)
SESSION_TIMEOUT_MINUTES=30
MAX_LOGIN_ATTEMPTS=5

# App
LOG_LEVEL=INFO
MAX_FILE_SIZE_MB=50
EXPORT_DIR=./exports
LOG_DIR=./logs
